# Copy to .env: copy .env.example .env
# Set strong values for production. Do not commit .env.
#
# Backend image: docker.io/crraay/habit-tracker-springboot:latest (see DOCKER.md / build-image workflow).
# Frontend: still built from ../habit-tracker-angular via docker-compose until Angular Hub pipeline exists.

# PostgreSQL
POSTGRES_DB=habit_tracker
POSTGRES_USER=habit
POSTGRES_PASSWORD=change_me

# Spring Boot: JDBC (defaults match docker-compose; override if needed)
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/habit_tracker?currentSchema=public
# SPRING_DATASOURCE_USERNAME=habit
# SPRING_DATASOURCE_PASSWORD=change_me

# App secrets (required for Docker backend container environment)

# JWT signing key for HS256. AuthServiceImpl decodes this with Base64 — plain phrases fail with "Illegal base64 character".
# Generate your own for production:
#   openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# Example below decodes to 32 bytes (UTF-8 of abcdefghijklmnopqrstuvwxyz012345) — replace in prod.
JWT_SECRET=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXowMTIzNDU=

# Same origin via nginx: include localhost. Add your production origins when needed.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
